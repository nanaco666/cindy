{
  "schemaVersion": 2,
  "id": "filo-google",
  "name": "Filo Google",
  "description": "Filo 内置的 Google 服务意识:连上你的 Google 账号即可读写 Gmail / 日历 / Drive / Sheets。开箱即用——内置应用身份,点「连接账号」完成授权即可;授权与令牌全程由主机托管。",
  "whenToUse": "需要查邮件、发邮件、写草稿(Gmail),查/建/改日程(Google 日历),搜索云端文件(Google Drive),读写表格(Google Sheets),或查看已连接的 Google 账号时找我(需先在意识设置页连接 Google 账号)。",
  "version": "1.2.2",
  "author": "Cindy",
  "icon": "assets/icon.png",
  "entry": "main.js",
  "settingsHtml": "settings.html",
  "slots": [
    "tool",
    "network"
  ],
  "command": "filo-google",
  "network": {
    "hosts": [
      "accounts.google.com",
      "oauth2.googleapis.com",
      "www.googleapis.com",
      "gmail.googleapis.com",
      "sheets.googleapis.com"
    ],
    "secrets": [
      {
        "key": "google_account",
        "label": "Google 账号",
        "source": "oauth",
        "hint": "使用内置的 Filo 应用身份,到设置页点「连接账号」即可,无需任何配置",
        "inject": {
          "header": "Authorization",
          "format": "Bearer {value}",
          "hosts": [
            "www.googleapis.com",
            "gmail.googleapis.com",
            "sheets.googleapis.com"
          ]
        },
        "oauth": {
          "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
          "tokenUrl": "https://oauth2.googleapis.com/token",
          "scopes": [
            "openid",
            "https://www.googleapis.com/auth/userinfo.email",
            "https://www.googleapis.com/auth/gmail.modify",
            "https://www.googleapis.com/auth/calendar",
            "https://www.googleapis.com/auth/drive",
            "https://www.googleapis.com/auth/spreadsheets"
          ],
          "pkce": true,
          "extraAuthorizeParams": {
            "access_type": "offline",
            "prompt": "consent"
          },
          "identity": {
            "url": "https://www.googleapis.com/oauth2/v3/userinfo",
            "labelPath": "email"
          }
        }
      }
    ]
  },
  "tools": [
    {
      "name": "google_accounts",
      "description": "列出已连接的 Google 账号(id / 邮箱 / 状态 / 是否默认)。其它工具的 account 参数填这里的账号 id;用户只连了一个账号时无需调用本工具。账号状态为 expired 时提示用户去意识设置页重新连接。",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "gmail",
      "description": "Gmail 操作(二级分派)。action=search:按 Gmail 搜索语法查邮件(如 from:xxx is:unread newer_than:7d);action=read:按 message_id 读正文;action=send:发邮件;action=draft:存草稿;action=modify_labels:加/去标签(归档=remove INBOX,已读=remove UNREAD,加星=add STARRED,回收站=add TRASH;显式动作需用户明确意图);action=list_labels:列全部标签(查自定义标签 id 用)。发送前把收件人/主题/正文给用户确认。返回 JSON。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "search",
              "read",
              "send",
              "draft",
              "modify_labels",
              "list_labels"
            ],
            "description": "操作类型"
          },
          "account": {
            "type": "string",
            "description": "账号 id(google_accounts 可查);省略 = 默认账号"
          },
          "query": {
            "type": "string",
            "description": "search:Gmail 搜索语法查询串"
          },
          "max_results": {
            "type": "number",
            "description": "search:返回条数,默认 5,最大 10"
          },
          "message_id": {
            "type": "string",
            "description": "read:邮件 id(search 结果里的 id)"
          },
          "to": {
            "type": "string",
            "description": "send/draft:收件人,多个用逗号分隔"
          },
          "subject": {
            "type": "string",
            "description": "send/draft:主题"
          },
          "body_text": {
            "type": "string",
            "description": "send/draft:纯文本正文"
          },
          "add_label_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "modify_labels:要添加的标签 id(系统标签如 STARRED/TRASH 直接用名;自定义标签先 list_labels 查 id)"
          },
          "remove_label_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "modify_labels:要移除的标签 id(如 INBOX/UNREAD)"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "google_calendar",
      "description": "Google 日历操作(二级分派)。action=list_calendars:列日历;action=list_events:查日程(time_min/time_max 为 ISO8601,如 2026-07-13T00:00:00+08:00);action=get_event:按 event_id 查单条详情;action=create_event:建日程;action=update_event:改日程(只传要改的字段);action=delete_event:删日程(删除前和用户确认)。calendar_id 省略 = 主日历。返回 JSON。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list_calendars",
              "list_events",
              "get_event",
              "create_event",
              "update_event",
              "delete_event"
            ],
            "description": "操作类型"
          },
          "account": {
            "type": "string",
            "description": "账号 id;省略 = 默认账号"
          },
          "calendar_id": {
            "type": "string",
            "description": "日历 id,省略 = primary(主日历)"
          },
          "time_min": {
            "type": "string",
            "description": "list_events:起始时间(ISO8601)"
          },
          "time_max": {
            "type": "string",
            "description": "list_events:结束时间(ISO8601)"
          },
          "max_results": {
            "type": "number",
            "description": "list_events:条数,默认 10,最大 25"
          },
          "event_id": {
            "type": "string",
            "description": "update/delete:日程 id"
          },
          "summary": {
            "type": "string",
            "description": "create/update:标题"
          },
          "description": {
            "type": "string",
            "description": "create/update:描述"
          },
          "start": {
            "type": "string",
            "description": "create/update:开始时间(ISO8601;全天事件传 YYYY-MM-DD)"
          },
          "end": {
            "type": "string",
            "description": "create/update:结束时间(同 start 格式)"
          },
          "attendees": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "create/update:参与者邮箱列表"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "google_drive",
      "description": "Google Drive 操作(二级分派)。action=search:搜文件;action=list_folder:列目录内容(folder_id 省略=根目录);action=get_meta:文件详情;action=read:读文件内容(Google 原生文件自动导出文本:Docs→Markdown/Sheets→CSV/Slides→纯文本,export_mime 可覆盖;普通文本文件直读;二进制回元数据+链接,要拿字节用 download);action=download:把文件下载到用户本地(需要主 agent 在 ghost_call 顶层 save_dir 传入目标目录,详见工具说明);action=upload:把文本内容存成 Drive 文件(≤200KB,显式动作);action=move:移动/改名(显式动作);action=delete:删除(缺省进回收站,permanent=true 永久删,需用户明确确认)。返回 JSON。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "search",
              "list_folder",
              "get_meta",
              "read",
              "download",
              "upload",
              "move",
              "delete"
            ],
            "description": "操作类型"
          },
          "account": {
            "type": "string",
            "description": "账号 id;省略 = 默认账号"
          },
          "query": {
            "type": "string",
            "description": "search:关键词(自动转 name contains)或完整 Drive 查询语法(含 = / contains 时原样使用)"
          },
          "max_results": {
            "type": "number",
            "description": "search:条数,默认 10,最大 25"
          },
          "file_id": {
            "type": "string",
            "description": "get_meta:文件 id"
          },
          "folder_id": {
            "type": "string",
            "description": "list_folder:目录 id,省略=根目录(root)"
          },
          "export_mime": {
            "type": "string",
            "description": "read:Google 原生文件的导出 MIME 覆盖(如 text/plain、text/csv)"
          },
          "filename": {
            "type": "string",
            "description": "download:建议保存文件名;缺省用 Drive 里的名字"
          },
          "name": {
            "type": "string",
            "description": "upload:文件名"
          },
          "content": {
            "type": "string",
            "description": "upload:文本内容(≤200KB)"
          },
          "mime_type": {
            "type": "string",
            "description": "upload:MIME 类型,缺省 text/plain"
          },
          "parent_folder_id": {
            "type": "string",
            "description": "upload:目标目录 id,省略=根目录"
          },
          "new_parent_id": {
            "type": "string",
            "description": "move:目标目录 id"
          },
          "new_name": {
            "type": "string",
            "description": "move:新文件名(与 new_parent_id 至少传一个)"
          },
          "permanent": {
            "type": "boolean",
            "description": "delete:true=永久删除(不可恢复,需用户明确确认);缺省移入回收站"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "google_sheets",
      "description": "Google Sheets 操作(二级分派)。action=list_sheets:列出表格里的工作表;action=read_range:读区间(range 用 A1 记法,如 Sheet1!A1:D20);action=write_range:写区间(values 为二维数组,按 USER_ENTERED 解析;写入前把目标区间和内容给用户确认)。spreadsheet_id 支持直接粘整条表格链接(自动提取 id)。返回 JSON。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list_sheets",
              "read_range",
              "write_range"
            ],
            "description": "操作类型"
          },
          "account": {
            "type": "string",
            "description": "账号 id;省略 = 默认账号"
          },
          "spreadsheet_id": {
            "type": "string",
            "description": "表格 id 或完整链接"
          },
          "range": {
            "type": "string",
            "description": "read/write:A1 记法区间(如 Sheet1!A1:D20)"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {}
            },
            "description": "write_range:二维数组,行 × 列"
          }
        },
        "required": [
          "action",
          "spreadsheet_id"
        ]
      }
    }
  ]
}
