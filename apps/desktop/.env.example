# Cindy auth-server 区域与地址（默认国内版；国际版显式改成 global + 对应地址）
VITE_CINDY_AUTH_REGION=cn
VITE_CINDY_AUTH_BASE_URL=http://localhost:3344

# 后端 API 地址（本地开发指向 apps/server，默认 3333）
VITE_API_BASE_URL=http://localhost:3333

# device-link relay 独立域名（可选）。不填时 WS/media/devices 回退到 VITE_API_BASE_URL。
# 生产构建由打包脚本注入;本地全栈开发不需要填（relay 与 server 同进程或本地 3335）。
VITE_DEVICE_LINK_API_BASE_URL=
# 独立 OAuth broker(意识 tokenBroker 模式换/刷 token);不填回退主 server 老路由
VITE_OAUTH_BROKER_API_BASE_URL=
VITE_SLACK_HOOK_WS_URL=
VITE_CDN_BASE_URL=
VITE_CDN_INTERNAL_BASE_URL=

# Filo Google OAuth desktop client（main-only，不进 renderer，也不要提交实际值）。
# 老版本升级会自动把已安装意识里的旧 client 搬进 safeStorage；全新开发环境和
# 正式构建需要由本机 .env / 发布环境注入。
XDT_FILO_GOOGLE_CLIENT_ID=
XDT_FILO_GOOGLE_CLIENT_SECRET=

# 心跳/在线统计 server。默认指向生产域名(config/production-endpoints.json 的 heartbeatUrl)
# dev / 自建测试环境 想覆盖时填这里;不填则用代码内默认值
VITE_HEARTBEAT_URL=

# XD 网关(litellm proxy)base URL 覆盖(可选)。embedding / Cindy 媒体代理等共用。
# 不填走代码内默认值(config/production-endpoints.json 的 xdGatewayBaseUrl)
VITE_XDPROXY_BASE_URL=

# 更新/资源 manifest 的 CDN 基址覆盖(可选,main 进程读 process.env)。
# 不填走代码内默认并自动探测内外网(见 src/shared/endpoints.ts)
XDT_CDN_BASE_URL=

# 语音输入模型配置（main-only，不会暴露到 renderer）
# 开发版可用这里作为默认值；安装版会在 userData 下生成 voice-input-models.json。
# 安装版请改那个 JSON 文件，下一次语音输入 / readiness 刷新时生效，不需要重新打包。

# ASR 模型供应商
# 可选：
# - litellm-volcengine-sauc-asr（默认）
# - litellm-qwen3-asr-flash-realtime
# - litellm-gpt-realtime-whisper
# - openai-realtime-whisper
# - litellm-batch
# - elevenlabs-scribe-realtime
XDT_VOICE_INPUT_ASR_PROVIDER=

# 润色模型供应商
# 可选：
# - codex-gpt-5.4-mini（默认）
# - codex-gpt-5.4-nano
# - litellm-gpt-5.4-mini
# - litellm-gpt-5.4-nano
# - litellm-deepseek-v4-flash
# - litellm-qwen3.6-plus
XDT_VOICE_INPUT_REFINER_PROVIDER=

# 高级：保留供应商 profile，只替换实际模型 ID。
# 例如：XDT_VOICE_INPUT_REFINER_PROVIDER=litellm 且这里填 qwen/qwen3.6-plus。
XDT_VOICE_INPUT_REFINER_MODEL=
