{
  "name": "desktop",
  "productName": "Cindy",
  "version": "1.0.0",
  "description": "Cindy desktop client (真实版本号在 release 时由脚本通过 APP_VERSION 注入,见 forge.config.ts)",
  "main": ".vite/build/index.js",
  "private": true,
  "scripts": {
    "dev:winsetup": "node -e \"if(process.platform==='win32'){try{require('child_process').execSync('chcp 65001',{stdio:'ignore'})}catch(e){}}\"",
    "build:remote-bundles": "node scripts/build-remote-bundles.mjs",
    "predev": "pnpm build:remote-bundles",
    "predev:remote": "pnpm build:remote-bundles",
    "predev:inspect": "pnpm build:remote-bundles",
    "prepackage": "pnpm build:remote-bundles",
    "prebuild": "pnpm build:remote-bundles",
    "dev": "pnpm dev:winsetup && node scripts/dev-local-env.mjs electron-forge start --",
    "dev:remote": "pnpm dev:winsetup && node scripts/dev-remote-env.mjs electron-forge start --",
    "dev:inspect": "pnpm dev:winsetup && cross-env OPEN_DEVTOOLS=1 node scripts/dev-remote-env.mjs electron-forge start --inspect-electron --",
    "package": "electron-forge package",
    "package:app": "node scripts/package-desktop.mjs",
    "release:package": "node scripts/package-desktop.mjs",
    "release:canary": "node scripts/publish-desktop.mjs",
    "build": "electron-forge make",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:validate": "node scripts/validate-migrations.mjs",
    "gen:help-kb": "node scripts/gen-help-kb.mjs",
    "gen:help-kb:check": "node scripts/help-kb-guard.mjs",
    "release:win": "node scripts/release-windows.mjs",
    "release:win:cn": "node scripts/release-windows.mjs",
    "release:win:global": "node scripts/release-windows.mjs --region global",
    "release:win:dev": "node scripts/release-windows.mjs --region dev",
    "release:mac": "node scripts/release-macos.mjs",
    "release:mac:cn": "node scripts/release-macos.mjs",
    "release:mac:global": "node scripts/release-macos.mjs --region global",
    "release:mac:dev": "node scripts/release-macos.mjs --region dev",
    "release:mac:arm64": "node scripts/release-macos.mjs --arch arm64",
    "release:mac:x64": "node scripts/release-macos.mjs --arch x64",
    "release:linux": "node scripts/release-linux.mjs",
    "release:promote:linux": "node scripts/promote-canary-linux.mjs",
    "release:promote:win": "node scripts/promote-canary-windows.mjs",
    "release:promote:win:cn": "node scripts/promote-canary-windows.mjs",
    "release:promote:win:global": "node scripts/promote-canary-windows.mjs --region global",
    "release:promote:win:dev": "node scripts/promote-canary-windows.mjs --region dev",
    "release:promote:mac": "node scripts/promote-canary-macos.mjs",
    "release:promote:mac:cn": "node scripts/promote-canary-macos.mjs",
    "release:promote:mac:global": "node scripts/promote-canary-macos.mjs --region global",
    "release:promote:mac:dev": "node scripts/promote-canary-macos.mjs --region dev",
    "release:promote:mac:arm64": "node scripts/promote-canary-macos.mjs --arch arm64",
    "release:promote:mac:x64": "node scripts/promote-canary-macos.mjs --arch x64",
    "release:claude-code": "node scripts/release-claude-code.mjs",
    "release:claude-code:arm64": "node scripts/release-claude-code.mjs --platform darwin-arm64",
    "release:claude-code:x64": "node scripts/release-claude-code.mjs --platform darwin-x64",
    "release:claude-code:win": "node scripts/release-claude-code.mjs --platform win32-x64",
    "release:claude-code:win:cn": "node scripts/release-claude-code.mjs --platform win32-x64 --region cn",
    "release:claude-code:win:global": "node scripts/release-claude-code.mjs --platform win32-x64 --region global",
    "release:claude-code:win:dev": "node scripts/release-claude-code.mjs --platform win32-x64 --region dev",
    "release:codex": "node scripts/release-codex.mjs",
    "release:codex:arm64": "node scripts/release-codex.mjs --platform darwin-arm64",
    "release:codex:x64": "node scripts/release-codex.mjs --platform darwin-x64",
    "release:codex:win": "node scripts/release-codex.mjs --platform win32-x64",
    "release:codex:win:cn": "node scripts/release-codex.mjs --platform win32-x64 --region cn",
    "release:codex:win:global": "node scripts/release-codex.mjs --platform win32-x64 --region global",
    "release:codex:win:dev": "node scripts/release-codex.mjs --platform win32-x64 --region dev",
    "release:ripgrep": "node scripts/release-ripgrep.mjs",
    "release:ripgrep:arm64": "node scripts/release-ripgrep.mjs --platform darwin-arm64",
    "release:ripgrep:x64": "node scripts/release-ripgrep.mjs --platform darwin-x64",
    "release:ripgrep:win": "node scripts/release-ripgrep.mjs --platform win32-x64",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write src/",
    "ensure-deps": "node ../../scripts/ensure-deps.mjs",
    "ensure-dev-runtime-assets": "node ../../scripts/ensure-dev-runtime-assets.mjs",
    "test": "vitest run",
    "test:db": "pnpm --dir ../.. test:runner && node ../../scripts/test-workspaces.mjs --tier db",
    "test:db-proxy-perf": "cross-env XDT_DB_PROXY_PERF_STRICT=1 vitest run src/main/localDb/__tests__/drizzle-proxy-perf.test.ts",
    "test:migration": "pnpm --dir ../.. test:runner && node ../../scripts/test-workspaces.mjs --tier migration",
    "test:migration-replay": "node ../../scripts/ensure-deps.mjs && node ../../scripts/ensure-dev-runtime-assets.mjs && vitest run src/main/localDb/__tests__/migrationReplay.test.ts",
    "test:watch": "vitest",
    "preview:oauth-pages": "tsx scripts/preview-oauth-pages.ts"
  },
  "author": {
    "name": "Lizi",
    "email": "feedback@cindy.app"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@cindy/auth-client": "workspace:*",
