{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "store-cn-base": {
      "distribution": "store",
      "environment": "production",
      "node": "22.19.0",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_CINDY_AUTH_REGION": "cn",
        "EXPO_PUBLIC_CINDY_AUTH_BASE_URL": "https://auth.cindy.com.cn",
        "EXPO_PUBLIC_XDT_API_BASE_URL": "https://xdt-api.magiclizi.com",
        "EXPO_PUBLIC_XDT_DEVICE_LINK_API_BASE_URL": "https://xdmaker-device-link.magiclizi.com",
        "XDT_SKIP_AGENT_BIN_INSTALL": "1"
      }
    },
    "testflight": {
      "extends": "store-cn-base",
      "channel": "production"
    },
    "production": {
      "extends": "store-cn-base",
      "channel": "production"
    },
    "store-global-base": {
      "distribution": "store",
      "environment": "production",
      "node": "22.19.0",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_CINDY_AUTH_REGION": "global",
        "EXPO_PUBLIC_CINDY_AUTH_BASE_URL": "https://auth.cindy.app",
        "EXPO_PUBLIC_XDT_API_BASE_URL": "https://xdt-api.magiclizi.com",
        "EXPO_PUBLIC_XDT_DEVICE_LINK_API_BASE_URL": "https://xdmaker-device-link.magiclizi.com",
        "XDT_SKIP_AGENT_BIN_INSTALL": "1"
      }
    },
    "testflight-global": {
      "extends": "store-global-base",
      "channel": "production-global"
    },
    "production-global": {
      "extends": "store-global-base",
      "channel": "production-global"
    },
    "adhoc": {
      "distribution": "internal",
      "channel": "staging",
      "environment": "preview",
      "node": "22.19.0",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_CINDY_AUTH_REGION": "cn",
        "EXPO_PUBLIC_CINDY_AUTH_BASE_URL": "https://auth.cindy.com.cn",
        "EXPO_PUBLIC_XDT_API_BASE_URL": "https://xdt-api.magiclizi.com",
        "EXPO_PUBLIC_XDT_DEVICE_LINK_API_BASE_URL": "https://xdmaker-device-link.magiclizi.com",
        "XDT_SKIP_AGENT_BIN_INSTALL": "1"
      }
    },
    "adhoc-global": {
      "extends": "adhoc",
      "channel": "staging-global",
      "env": {
        "EXPO_PUBLIC_CINDY_AUTH_REGION": "global",
        "EXPO_PUBLIC_CINDY_AUTH_BASE_URL": "https://auth.cindy.app"
      }
    },
    "beta-base": {
      "distribution": "store",
      "environment": "preview",
      "node": "22.19.0",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "resourceClass": "medium"
      },
      "env": {
        "EXPO_PUBLIC_CINDY_AUTH_REGION": "cn",
        "EXPO_PUBLIC_CINDY_AUTH_BASE_URL": "https://auth.cindy.com.cn",
        "EXPO_PUBLIC_XDT_API_BASE_URL": "https://xdt-api.magiclizi.com",
        "EXPO_PUBLIC_XDT_DEVICE_LINK_API_BASE_URL": "https://xdmaker-device-link.magiclizi.com",
        "EXPO_PUBLIC_APP_VARIANT": "beta",
        "XDT_SKIP_AGENT_BIN_INSTALL": "1"
      }
    },
    "beta-dash": {
      "extends": "beta-base",
      "channel": "beta-dash",
      "env": {
        "EXPO_PUBLIC_BETA_DEV": "dash"
      }
    },
    "beta-global-base": {
      "extends": "beta-base",
      "env": {
        "EXPO_PUBLIC_CINDY_AUTH_REGION": "global",
        "EXPO_PUBLIC_CINDY_AUTH_BASE_URL": "https://auth.cindy.app"
      }
    },
    "beta-global-dash": {
      "extends": "beta-global-base",
      "channel": "beta-global-dash",
      "env": {
        "EXPO_PUBLIC_BETA_DEV": "dash"
      }
    }
  }
}
