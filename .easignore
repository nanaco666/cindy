# EAS iOS builds for apps/mobile run from the monorepo root. Keep the
# archive focused on the mobile app plus the shared packages Metro imports.

.git
.DS_Store
.expo
node_modules
**/node_modules
**/.env
**/.env.*
!.env.example
!apps/mobile/.env.example

.agents
.claude
.xdmaker
agent-use
docs
scripts/*
!scripts/ensure-agent-binaries.mjs
!scripts/agent-binary-cdn-fallback.mjs
!scripts/fix-node-pty-perms.mjs
THIRD-PARTY-NOTICES.txt
.gitlab-ci*

apps/*
!apps/mobile
!apps/mobile/**
apps/mobile/.expo
apps/mobile/ios
apps/mobile/android
apps/mobile/e2e
apps/mobile/docs
apps/mobile/visual-*.png

packages/*
!packages/auth-client
!packages/auth-client/**
!packages/device-link
!packages/device-link/**
!packages/maker-shared
!packages/maker-shared/**
!packages/model-providers
!packages/model-providers/**
!packages/voice-input-core
!packages/voice-input-core/**

# mobile 的 device-link 传递依赖 cindy-protocol submodule；EAS 上传必须带源码。
!cindy-protocol
!cindy-protocol/**

tools/*
!tools/codex-platform-stub
!tools/codex-platform-stub/**
!tools/shared
!tools/shared/fetch-with-timeout.mjs
